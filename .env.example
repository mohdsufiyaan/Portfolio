# Optional: Override canonical origin for SEO metadata, sitemap.xml, and robots.txt.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are automatically detected if omitted.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional (Server-Only): Fine-grained GitHub Personal Access Token (read-only public/contribution scope).
# Never exposed to the browser. Unlocks full 52-week GitHub GraphQL contribution calendar squares
# (including private enterprise commit counts) with higher API rate limits.
GITHUB_TOKEN=
